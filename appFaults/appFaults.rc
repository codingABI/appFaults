#include "resource.h"
#include "windows.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

/////////////////////////////////////////////////////////////////////////////
//
// Icons
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_APPFAULTS               ICON                    "appFaults.ico"

IDI_APPICON16               ICON                    "gear16.ico"
IDI_APPICON32               ICON                    "gear32.ico"
IDI_APPICON48               ICON                    "gear48.ico"
IDI_APPICON64               ICON                    "gear64.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1, 0, 0, 3
PRODUCTVERSION 1, 0, 0, 3
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040704b0"
		BEGIN
			VALUE "CompanyName", "codingABI"
			VALUE "FileDescription", "Test/stress tool"
			VALUE "FileVersion", "1.0.0.3"
			VALUE "InternalName", "appFaults.exe"
			VALUE "LegalCopyright", "© 2024-2026 codingABI"
			VALUE "OriginalFilename", "appFaults.exe"
			VALUE "ProductName", "appFaults"
			VALUE "ProductVersion", "1.0.0.3"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x407, 1200
	END
END

